# Copy to .env (gitignored) and fill in. Real environments should set these as environment variables.
DB_URL=jdbc:postgresql://localhost:5432/audit_vault_db
DB_USERNAME=postgres
DB_PASSWORD=
AI_API_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_API_MODEL=openai/gpt-oss-120b
AI_API_VISION_MODEL=qwen/qwen3.8-27b
# Creates a demo company and login with a known password. Local development only.
SEED_DEMO_DATA=true

# The Vault Core operator: creates client companies. A one-time link to set the password is
# printed to the log at startup until the operator has signed in.
VAULT_OPERATOR_EMAIL=
# Where people reach the app; used in links printed at startup
VAULT_PUBLIC_URL=http://localhost:8080
